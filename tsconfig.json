// tsconfig.json
{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "WebWorker"],
		"paths": {
			"@/*": ["*"]
		},
		"module": "node16",
		"moduleResolution": "node16",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"baseUrl": "./src",
		"forceConsistentCasingInFileNames": true,
		"types": ["./worker-configuration.d.ts"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
